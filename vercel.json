{
  "trailingSlash": true,
  "redirects": [
    { "source": "/from-the-sea", "destination": "/our-products/", "permanent": true },
    { "source": "/from-the-sea/", "destination": "/our-products/", "permanent": true },
    { "source": "/list-of-all-fleet-vessels", "destination": "/our-fleet/", "permanent": true },
    { "source": "/list-of-all-fleet-vessels/", "destination": "/our-fleet/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
